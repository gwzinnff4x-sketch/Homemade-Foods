@charset "utf-8";

:root { --charcoal: #232320; --cream: #FBF3E7; --tomato: #C1442E; --mustard: #E3A23A; --sage: #6E7F5C; }

* { box-sizing: border-box; }

html { scroll-behavior: smooth; }

body { margin: 0px; background: var(--cream); color: var(--charcoal); font-family: Inter, sans-serif; line-height: 1.6; }

.wrap { max-width: 1100px; margin: 0px auto; padding: 0px 20px; }

header { background: var(--charcoal); color: var(--cream); padding: 20px 0px; position: sticky; top: 0px; z-index: 100; }

header .wrap { display: flex; justify-content: space-between; align-items: center; }

.brand { font-family: Fraunces, serif; font-size: 24px; font-weight: 700; }

nav a { color: var(--cream); text-decoration: none; margin-left: 20px; font-size: 14px; opacity: 0.8; }

.hero { padding: 100px 0px; text-align: center; }

.hero h1 { font-family: Fraunces, serif; font-size: 4rem; margin: 0px; line-height: 1.1; }

.store-section { padding: 80px 0px; background: rgb(243, 232, 214); border-top: 1px solid rgba(0, 0, 0, 0.05); }

.store-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 30px; margin-top: 40px; }

.book-card { background: white; padding: 40px; border-radius: 20px; box-shadow: rgba(0, 0, 0, 0.05) 0px 10px 30px; transition: 0.3s; position: relative; }

.book-badge { background: var(--tomato); color: white; padding: 4px 12px; border-radius: 20px; font-size: 12px; font-weight: 700; text-transform: uppercase; margin-bottom: 20px; display: inline-block; }

.book-price { font-size: 2.2rem; font-weight: 700; margin: 20px 0px; }

.btn-buy { background: var(--charcoal); color: white; padding: 16px 32px; border-radius: 50px; text-decoration: none; display: block; text-align: center; font-weight: 700; transition: 0.3s; }

.btn-buy-destaque { background: linear-gradient(135deg, rgb(193, 68, 46) 0%, rgb(227, 162, 58) 100%); border-radius: 50px; text-decoration: none; display: block; text-align: center; font-weight: 800; font-size: 1.05rem; text-transform: uppercase; letter-spacing: 1px; transition: 0.3s; box-shadow: rgba(193, 68, 46, 0.4) 0px 8px 25px; animation: 2s ease 0s infinite normal none running pulse-btn; position: relative; overflow: hidden; color: white !important; padding: 18px 36px !important; }

.btn-buy-destaque::before { content: ""; position: absolute; top: -50%; left: -50%; width: 200%; height: 200%; background: linear-gradient(45deg, transparent, rgba(255, 255, 255, 0.15), transparent); transform: rotate(45deg); animation: 3s ease 0s infinite normal none running shine; }

.btn-buy-destaque:hover { transform: translateY(-3px) scale(1.03); box-shadow: rgba(193, 68, 46, 0.6) 0px 12px 35px; }

@keyframes pulse-btn { 
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.02); }
}

@keyframes shine { 
  0% { transform: translateX(-100%) rotate(45deg); }
  100% { transform: translateX(100%) rotate(45deg); }
}

.mini-livro-card { border: 3px solid var(--tomato) !important; background: linear-gradient(145deg, rgb(255, 255, 255) 0%, rgb(255, 248, 240) 100%) !important; }

.mini-livro-card:hover { transform: translateY(-8px) !important; box-shadow: rgba(193, 68, 46, 0.15) 0px 15px 40px !important; }

.tag-urgente { background: var(--tomato); color: white; padding: 4px 14px; border-radius: 20px; font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: 1px; margin-top: 12px; display: inline-block; animation: 1.5s ease 0s infinite normal none running blink-tag; }

@keyframes blink-tag { 
  0%, 100% { opacity: 1; }
  50% { opacity: 0.7; }
}

.desconto-tag { position: absolute; top: -12px; right: 20px; background: rgb(231, 76, 60); color: white; padding: 6px 14px; border-radius: 20px; font-size: 12px; font-weight: 800; box-shadow: rgba(231, 76, 60, 0.4) 0px 4px 12px; z-index: 2; }

.livro-completo-card { border: 3px solid var(--mustard) !important; background: linear-gradient(145deg, rgb(255, 255, 255) 0%, rgb(254, 249, 239) 100%) !important; position: relative !important; overflow: visible !important; box-shadow: rgba(227, 162, 58, 0.2) 0px 10px 30px !important; transition: 0.4s !important; }

.livro-completo-card:hover { transform: translateY(-10px) scale(1.01) !important; box-shadow: rgba(227, 162, 58, 0.35) 0px 20px 50px !important; }

.livro-completo-card::after { content: ""; position: absolute; top: 0px; left: 0px; right: 0px; height: 4px; background: linear-gradient(90deg, var(--tomato), var(--mustard), var(--tomato)); border-radius: 20px 20px 0px 0px; }

.badge-mais-vendido { background: linear-gradient(135deg, rgb(227, 162, 58) 0%, rgb(212, 146, 46) 100%); color: var(--charcoal); padding: 5px 16px; border-radius: 20px; font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: 1px; display: inline-block; box-shadow: rgba(227, 162, 58, 0.4) 0px 4px 12px; animation: 2.5s ease 0s infinite normal none running pulse-badge; }

@keyframes pulse-badge { 
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.05); }
}

.btn-completo { background: linear-gradient(135deg, rgb(227, 162, 58) 0%, rgb(201, 144, 31) 100%); border-radius: 50px; text-decoration: none; display: block; text-align: center; font-weight: 800; font-size: 1.05rem; text-transform: uppercase; letter-spacing: 1px; transition: 0.3s; box-shadow: rgba(227, 162, 58, 0.45) 0px 8px 25px; position: relative; overflow: hidden; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; cursor: pointer; color: var(--charcoal) !important; padding: 18px 36px !important; }

.btn-completo::before { content: ""; position: absolute; top: -50%; left: -50%; width: 200%; height: 200%; background: linear-gradient(45deg, transparent, rgba(255, 255, 255, 0.3), transparent); transform: rotate(45deg); animation: 2.5s ease 0s infinite normal none running shine; }

.btn-completo:hover { transform: translateY(-3px) scale(1.03); box-shadow: rgba(227, 162, 58, 0.65) 0px 14px 40px; }

.tag-comparacao { background: rgb(240, 240, 240); color: rgb(85, 85, 85); padding: 5px 14px; border-radius: 20px; font-size: 11px; font-weight: 700; margin-top: 10px; display: inline-block; border: 1px solid rgb(221, 221, 221); }

.beneficios-list { list-style: none; padding: 0px; margin: 12px 0px; }

.beneficios-list li { font-size: 13px; color: rgb(68, 68, 68); padding: 3px 0px; }

.tag-garantia { background: rgb(39, 174, 96); color: white; padding: 4px 14px; border-radius: 20px; font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: 1px; margin-top: 12px; display: inline-block; }

.recipes-section { padding: 80px 0px; }

.recipe-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; margin-top: 40px; }

.recipe-card { border: 1px solid rgba(0, 0, 0, 0.1); padding: 30px; border-radius: 12px; background: white; overflow: hidden; }

.recipe-card img { width: 100%; height: 200px; object-fit: cover; border-radius: 8px; margin-bottom: 15px; display: block; }

.recipe-content { display: none; margin-top: 20px; padding-top: 20px; border-top: 1px dashed rgb(204, 204, 204); }

.recipe-content.active { display: block; }

.form-section { padding: 80px 0px; background: white; }

.contact-form { max-width: 600px; margin: 40px auto; display: grid; gap: 15px; }

.contact-form input, .contact-form select, .contact-form textarea { width: 100%; padding: 12px; border: 1px solid rgb(221, 221, 221); border-radius: 8px; font-family: inherit; }

.btn-submit { background: var(--charcoal); color: white; padding: 12px; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; border-radius: 8px; cursor: pointer; font-weight: 700; }

.newsletter { background: var(--charcoal); color: var(--cream); padding: 60px 0px; text-align: center; }

.newsletter input { padding: 12px; border-radius: 8px; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; width: 250px; margin: 5px; }

footer { background: rgb(26, 26, 24); color: var(--cream); padding: 40px 0px; text-align: center; font-size: 14px; }
